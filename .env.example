# Cadastre estas variáveis em Settings > Environment Variables na Vercel.
# Este arquivo é apenas um modelo e não é carregado automaticamente no modo local.
TURSO_DATABASE_URL=libsql://seu-banco-sua-organizacao.turso.io
TURSO_AUTH_TOKEN=substitua-pelo-token-do-banco
SESSION_SECRET=substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Opcional para domínio próprio. Domínios informados pela Vercel são aceitos automaticamente.
ALLOWED_HOSTS=
# Opcional:
BRAPI_TOKEN=
